{
  "name": "@ai4rpg/dsh-tavern-preset",
  "description": "DSH agent preset for the tavern-cards workflow: the stage machine, project tooling, tavern skills, four delegation tools, and their internal child presets composed into one declared preset",
  "version": "0.2.0",
  "license": "SEE LICENSE IN LICENSE.md",
  "private": true,
  "type": "module",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0",
    "node": "^22.19 || >=24"
  },
  "files": [
    "cordis.patch.yml",
    "skills",
    "persona.yml",
    "stage-display.json",
    "docs",
    "README.md",
    "README.zh.md",
    "LICENSE.md",
    "scripts/gen-preset.mjs",
    "scripts/load-agents.mjs",
    "scripts/sync-skills.mjs",
    "scripts/mechanical-check-overlay.mjs"
  ],
  "scripts": {
    "gen": "node scripts/gen-preset.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai4rpg/dsh-stage-switch": "^0.2.1",
    "@ai4rpg/dsh-tavern-stages": "^0.3.0",
    "@ai4rpg/dsh-ui-sidebar-stage": "^0.2.0"
  },
  "devDependencies": {
    "@ai4rpg/dsh-stage-switch": "^0.2.1",
    "@ai4rpg/dsh-tavern-stages": "^0.3.0",
    "@ai4rpg/dsh-ui-sidebar-stage": "^0.2.0",
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/cordis-plugin-include": "^1.0.10",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.6",
    "@deepseek-ai/dsh-agent": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-instructions": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-loop": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-loop-testkit": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-preset": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-command-compact": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-compaction-basic": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-fs": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-persona": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-subagent": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-subagent-spawn-in-process": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-token-meter": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-bash": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-fs": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-fs-search": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-skill": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-subagent": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-web-app": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-working-directory": "^0.2.1-rc.2",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0",
    "yaml": "^2.8.4"
  },
  "//dependencies-note": "The @ai4rpg runtime dependencies are versioned ranges from npm. Persona sources are external generation inputs read from TAVERN_CARDS_ROOT/agents; the installed preset uses only the bodies embedded in cordis.patch.yml. No source package or upstream checkout is needed to install. @ai4rpg/dsh-tavern-stages supplies tavernCardsStageConfig; @ai4rpg/dsh-stage-switch and @ai4rpg/dsh-ui-sidebar-stage back rows declared by this preset. The @deepseek-ai/* devDependencies provide the real composed services for tests and the official standard base the generator reads."
}
